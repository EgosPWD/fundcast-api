{
  "openapi": "3.1.0",
  "info": {
    "title": "Startup Funding API",
    "description": "Estimates the USD amount of a startup funding round.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Public sign-up. Always creates role `user`.",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "predictions"
        ],
        "summary": "Predict",
        "description": "Estimate the round amount in USD and store it in the caller's history.",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/predictions": {
      "get": {
        "tags": [
          "predictions"
        ],
        "summary": "List Predictions",
        "description": "History, newest first: a `user` sees only their own predictions, an `admin` all.",
        "operationId": "list_predictions_predictions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "1-based page number",
              "default": 1,
              "title": "Page"
            },
            "description": "1-based page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "items per page, 1-100",
              "default": 20,
              "title": "Size"
            },
            "description": "items per page, 1-100"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionPage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/options": {
      "get": {
        "tags": [
          "predictions"
        ],
        "summary": "Get Options",
        "description": "Categories of the active model for the prediction form, plus the cities of each country.\n\nOffer them as closed lists: the model matches categories by exact text, and any other\ntext is treated as unknown. After a retrain activates a new version the lists change.",
        "operationId": "get_options_options_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "metrics"
        ],
        "summary": "Get Metrics",
        "description": "Metrics of the active model version and the history of every version.",
        "operationId": "get_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/training-files": {
      "post": {
        "tags": [
          "training"
        ],
        "summary": "Upload Training File",
        "description": "Validate a CSV and insert its rows into funding_rounds.",
        "operationId": "upload_training_file_training_files_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_training_file_training_files_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingFileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/retrain": {
      "post": {
        "tags": [
          "training"
        ],
        "summary": "Retrain",
        "description": "Retrain on every row of funding_rounds with a new stratified 80/20 split.",
        "operationId": "retrain_retrain_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrainResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_training_file_training_files_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "CSV with the columns of AGENTS.md section 13"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_training_file_training_files_post"
      },
      "CategoryWarningSchema": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "`unknown_category`: the value is treated as unknown"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "code",
          "field",
          "value"
        ],
        "title": "CategoryWarningSchema"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MetricsResponse": {
        "properties": {
          "active": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelVersionResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/ModelVersionResponse"
            },
            "type": "array",
            "title": "Versions"
          }
        },
        "type": "object",
        "required": [
          "active",
          "versions"
        ],
        "title": "MetricsResponse"
      },
      "MetricsSchema": {
        "properties": {
          "mae_log": {
            "type": "number",
            "title": "Mae Log"
          },
          "r2": {
            "type": "number",
            "title": "R2"
          },
          "rmse_log": {
            "type": "number",
            "title": "Rmse Log"
          },
          "mdape": {
            "type": "number",
            "title": "Mdape"
          },
          "coverage": {
            "type": "number",
            "title": "Coverage"
          }
        },
        "type": "object",
        "required": [
          "mae_log",
          "r2",
          "rmse_log",
          "mdape",
          "coverage"
        ],
        "title": "MetricsSchema"
      },
      "ModelVersionResponse": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsSchema"
          },
          "n_train": {
            "type": "integer",
            "title": "N Train"
          },
          "n_test": {
            "type": "integer",
            "title": "N Test"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "training_file_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Training File Id"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "version",
          "is_active",
          "metrics",
          "n_train",
          "n_test",
          "params"
        ],
        "title": "ModelVersionResponse"
      },
      "OptionsResponse": {
        "properties": {
          "stages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stages"
          },
          "sectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sectors"
          },
          "countries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Countries"
          },
          "cities_by_country": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Cities By Country"
          },
          "lead_investors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lead Investors"
          },
          "news_sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "News Sources"
          },
          "model_version": {
            "type": "integer",
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "stages",
          "sectors",
          "countries",
          "cities_by_country",
          "lead_investors",
          "news_sources",
          "model_version"
        ],
        "title": "OptionsResponse",
        "description": "Vocabulary of the ACTIVE model (sorted, case-sensitive); send values as they are.\nAny other text is treated as unknown (average estimate) and reported in `warnings`."
      },
      "PredictRequest": {
        "properties": {
          "year": {
            "type": "integer",
            "title": "Year",
            "examples": [
              2025
            ]
          },
          "founded_year": {
            "type": "integer",
            "title": "Founded Year",
            "examples": [
              2021
            ]
          },
          "stage": {
            "type": "string",
            "title": "Stage",
            "examples": [
              "Seed"
            ]
          },
          "sector": {
            "type": "string",
            "title": "Sector",
            "examples": [
              "Fintech"
            ]
          },
          "country": {
            "type": "string",
            "title": "Country",
            "examples": [
              "United States"
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City",
            "examples": [
              "New York"
            ]
          },
          "investor_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Investor Count",
            "examples": [
              3
            ]
          },
          "lead_investor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Investor",
            "examples": [
              "Y Combinator"
            ]
          },
          "news_mentions": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "News Mentions",
            "examples": [
              2
            ]
          },
          "news_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "News Source",
            "examples": [
              "techcrunch.com"
            ]
          },
          "company_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Domain",
            "examples": [
              "acme.io"
            ]
          },
          "prev_rounds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Rounds",
            "examples": [
              1
            ]
          },
          "prev_amount_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Amount Usd",
            "examples": [
              1500000
            ]
          }
        },
        "type": "object",
        "required": [
          "year",
          "founded_year",
          "stage",
          "sector",
          "country"
        ],
        "title": "PredictRequest",
        "description": "What the client sends; the API derives the 14 model columns from it.\n\nUnknown fields (for example `news_excerpt`) are ignored and never stored."
      },
      "PredictResponse": {
        "properties": {
          "prediction_id": {
            "type": "integer",
            "title": "Prediction Id"
          },
          "estimated_amount_usd": {
            "type": "number",
            "title": "Estimated Amount Usd"
          },
          "estimated_log10": {
            "type": "number",
            "title": "Estimated Log10"
          },
          "range_usd": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Range Usd"
          },
          "model_version": {
            "type": "integer",
            "title": "Model Version"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/CategoryWarningSchema"
            },
            "type": "array",
            "title": "Warnings",
            "description": "One entry per categorical value the model does not know"
          }
        },
        "type": "object",
        "required": [
          "prediction_id",
          "estimated_amount_usd",
          "estimated_log10",
          "range_usd",
          "model_version"
        ],
        "title": "PredictResponse"
      },
      "PredictionItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "model_version_id": {
            "type": "integer",
            "title": "Model Version Id"
          },
          "input": {
            "$ref": "#/components/schemas/PredictRequest"
          },
          "estimated_amount_usd": {
            "type": "number",
            "title": "Estimated Amount Usd"
          },
          "estimated_log10": {
            "type": "number",
            "title": "Estimated Log10"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "model_version_id",
          "input",
          "estimated_amount_usd",
          "estimated_log10"
        ],
        "title": "PredictionItem"
      },
      "PredictionPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PredictionItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
